# Resend — https://resend.com/docs/send-with-nextjs
# Create an API key and verify the sending domain at https://resend.com/domains.
# Do not commit real values. Copy this file to .env.local.

RESEND_API_KEY=
INQUIRY_FROM_EMAIL=KodRoot <hello@mail.kodroot.com>
INQUIRY_TO_EMAIL=hello@kodroot.com

# Test-only. Never set this on Vercel. Automated tests use it so they do not
# send real email. Values: sent | failed | unavailable
# INQUIRY_MOCK_DELIVERY=
